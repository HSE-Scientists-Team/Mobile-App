<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the encrypted session stays out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="matchlab_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="matchlab_secure.xml" />
    </device-transfer>
</data-extraction-rules>
