    <!-- Dates: month names are abbreviated and used on their own ("Oct"), before a year or after a day. -->
    <string-array name="date_months_short">
        <item>Jan</item>
        <item>Feb</item>
        <item>Mar</item>
        <item>Apr</item>
        <item>May</item>
        <item>Jun</item>
        <item>Jul</item>
        <item>Aug</item>
        <item>Sep</item>
        <item>Oct</item>
        <item>Nov</item>
        <item>Dec</item>
    </string-array>
    <!-- Month names next to a day number; differ from the names above only in some languages. -->
    <string-array name="date_months_short_day">
        <item>Jan</item>
        <item>Feb</item>
        <item>Mar</item>
        <item>Apr</item>
        <item>May</item>
        <item>Jun</item>
        <item>Jul</item>
        <item>Aug</item>
        <item>Sep</item>
        <item>Oct</item>
        <item>Nov</item>
        <item>Dec</item>
    </string-array>
    <!-- 1: month name, 2: year -->
    <string name="date_year_month">%1$s %2$d</string>
    <!-- 1: start month, 2: end month, both already formatted by date_year_month -->
    <string name="date_month_range">%1$s – %2$s</string>
    <!-- 1: day of month, 2: month name -->
    <string name="date_day_month">%2$s %1$d</string>
</resources>
