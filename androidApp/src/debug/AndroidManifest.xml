<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds may talk to a local Docker Compose of the backend over plain HTTP, and only to the host of the
         emulator (10.0.2.2) and to localhost: see res/xml/network_security_config.xml. Release builds keep the
         platform default, which refuses cleartext traffic everywhere. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug-only catalog of the design system components:
             adb shell am start -n org.matchlab.academic_net/.catalog.CatalogActivity -->
        <activity
            android:name=".catalog.CatalogActivity"
            android:exported="true" />
    </application>

</manifest>
